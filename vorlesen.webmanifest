{
  "name": "Vorlese-App",
  "short_name": "Vorlesen",
  "description": "Text vorlesen, selbst vorlesen, diktieren, übersetzen, Sprachnachrichten in Text umwandeln",
  "lang": "de",
  "id": "Vorlesen",
  "start_url": "Vorlesen",
  "scope": "Vorlesen",
  "display": "standalone",
  "background_color": "#0f1a2b",
  "theme_color": "#0f1a2b",
  "icons": [
    {
      "src": "vorlesen-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "vorlesen-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "Vorlesen-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".opus",
            ".ogg",
            ".m4a",
            ".aac",
            ".mp3",
            ".wav"
          ]
        }
      ]
    }
  }
}